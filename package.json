{
  "name": "intrack-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format-check": "prettier --check .",
    "lint": "pnpm -r --filter ./packages/* run lint",
    "format": "pnpm -r --filter ./packages/* run format",
    "build": "pnpm -r --filter ./packages/intrack run build",
    "start": "pnpm -r --filter ./packages/intrack run dev",
    "typecheck": "pnpm -r --filter ./packages/* run typecheck"
  },
  "keywords": [],
  "author": "Intrack",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.7.9",
    "lodash-es": "^4.17.21",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.13.4",
    "autoprefixer": "^10.4.20",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "eslint": "^9.20.1",
    "@types/lodash-es": "4.17.12",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "postcss": "8.5.1",
    "prettier": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "release-it": "^17.6.0",
    "rimraf": "^6.0.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "pnpm": {
    "overrides": {
      "@intrack/store": "workspace:*",
      "@intrack/utils": "workspace:*",
      "@intrack/services": "workspace:*",
      "@intrack/benchmarks": "workspace:*"
    },
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  },
  "resolutions": {
    "glob": "11.0.1"
  }
}
